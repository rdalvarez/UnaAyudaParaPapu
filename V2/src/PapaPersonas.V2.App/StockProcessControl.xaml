<UserControl x:Class="PapaPersonas.V2.App.StockProcessControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Generación y consulta de stock" />
            <Border x:Name="OriginContainer" Margin="0,6,0,8" Padding="10" Background="#FFF8F9FA" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="StockOriginStatusTextBlock" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock x:Name="StockFileTextBlock" Margin="0,2,0,2" TextWrapping="Wrap" />
                    <TextBlock x:Name="OfficialFileTextBlock" Margin="0,2,0,2" TextWrapping="Wrap" />
                    <TextBlock x:Name="StockGeneratedTextBlock" Margin="0,2,0,2" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="OriginWarningTextBlock" Foreground="#FF8A5A00" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusTextBlock" Margin="0,2,0,4" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="CatalogWarningTextBlock" Foreground="#FF8A5A00" Margin="0,2,0,4" TextWrapping="Wrap" Visibility="Collapsed" />
            <GroupBox Header="Columnas de esta generación">
                <StackPanel Margin="8">
                    <TextBlock x:Name="PrimaryKeyTextBlock" TextWrapping="Wrap" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Código" />
                        <ComboBox x:Name="CodeComboBox" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Descripción" />
                        <ComboBox x:Name="DescriptionComboBox" />
                    </DockPanel>
                    <Button x:Name="GenerateButton" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Generar stock" Click="GenerateButton_OnClick" />
                </StackPanel>
            </GroupBox>
            <TextBlock x:Name="CountsTextBlock" Margin="0,8,0,8" />
            <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Vendido" Binding="{Binding Sold}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Reservado" Binding="{Binding Reserved}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Disponible" Binding="{Binding Available}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="SaveNamesButton" Content="Guardar nombres" Click="SaveNamesButton_OnClick" />
                <Button x:Name="SummaryButton" Margin="8,0,0,0" Content="Exportar resumen" Click="SummaryButton_OnClick" />
                <Button x:Name="DetailButton" Margin="8,0,0,0" Content="Exportar detalle" Click="DetailButton_OnClick" />
                <CheckBox x:Name="OnlyAvailableCheckBox" Margin="8,0,0,0" VerticalAlignment="Center" Content="Solo disponibles" />
            </StackPanel>
            <ListBox x:Name="ExportColumnsListBox" Height="90" Margin="0,8,0,0" />
            <DockPanel Margin="0,8,0,0">
                <TextBlock Width="140" VerticalAlignment="Center" Text="Referencia" />
                <TextBox x:Name="ReferenceTextBox" CharacterCasing="Upper" />
            </DockPanel>
            <Button x:Name="ExtractButton" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Extraer selección" Click="ExtractButton_OnClick" />
            <GroupBox Header="Extracción pendiente" Margin="0,12,0,0">
                <StackPanel Margin="8">
                    <TextBlock x:Name="PendingTextBlock" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RetryButton" Content="Reintentar" Click="RetryButton_OnClick" />
                        <Button x:Name="RetryOtherButton" Margin="8,0,0,0" Content="Guardar en otra ruta" Click="RetryOtherButton_OnClick" />
                        <Button x:Name="CancelPendingButton" Margin="8,0,0,0" Content="Cancelar pendiente" Click="CancelPendingButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Extracciones completadas" Margin="0,12,0,0">
                <StackPanel Margin="8">
                    <ListBox x:Name="CompletedListBox" Height="90" />
                    <Button x:Name="ReexportButton" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Reexportar seleccionada" Click="ReexportButton_OnClick" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
