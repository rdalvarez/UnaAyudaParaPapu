<Window x:Class="PapaPersonas.V2.App.SergioHeaderIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar encabezados de Sergio" Width="760" Height="560"
        MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Se detectaron encabezados que necesitan alias" />
        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Text="Solo se leyeron los encabezados. Todavía no se procesaron filas ni se guardó nada. Si continúa, estos alias se usarán más adelante." />
        <Border Grid.Row="2" BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SummaryTextBlock" Margin="0,0,0,8" FontWeight="SemiBold" />
                    <ItemsControl x:Name="MappingsItemsControl" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="110" Margin="0,0,8,0" Content="Cancelar" IsCancel="True" Click="CancelButton_OnClick" />
            <Button Width="110" Content="Continuar" IsDefault="True" Click="ContinueButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
