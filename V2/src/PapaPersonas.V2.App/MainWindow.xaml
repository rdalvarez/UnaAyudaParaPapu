<Window x:Class="PapaPersonas.V2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PapaPersonas V2"
        Height="760" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" CornerRadius="8" BorderBrush="#FFE6E6E6" BorderThickness="1" Background="#FFFDFDFD">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Text="PapaPersonas V2" />
                <TextBlock Margin="0,4,0,0" Foreground="#FF666666" Text="Shell visual — Solapa 1 en preparación" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem x:Name="PrepararTab">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="150" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Preparar archivo de Hernán" />
                            <TextBlock Margin="0,4,0,14" Foreground="#FF666666" Text="La selección de archivo y la lectura de encabezados están disponibles. La limpieza, exportación y persistencia todavía no." TextWrapping="Wrap" />

                            <GroupBox Header="Archivos" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Archivo de entrada" />
                                    <TextBox x:Name="InputFileTextBox" Grid.Row="0" Grid.Column="1" Margin="8,4" IsReadOnly="True" />
                                    <Button x:Name="BrowseFileButton" Grid.Row="0" Grid.Column="2" Margin="8,4" Content="Buscar archivo" Click="BrowseFileButton_OnClick" />
                                    <TextBlock x:Name="RejectedFolderLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Carpeta de rechazados" Cursor="Hand" Foreground="#FF245A9B" TextDecorations="Underline" MouseLeftButtonUp="RejectedFolderLabel_OnClick" />
                                    <TextBox x:Name="RejectedFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4" IsReadOnly="True" />
                                    <Button x:Name="BrowseFolderButton" Grid.Row="1" Grid.Column="2" Margin="8,4" Content="Buscar carpeta" Click="BrowseFolderButton_OnClick" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Columnas detectadas" Padding="10" Margin="0,12,0,0">
                                <ListBox x:Name="DetectedColumnsListBox" Height="72" DisplayMemberPath="DisplayName" AutomationProperties.Name="Columnas detectadas" />
                            </GroupBox>

                            <GroupBox Header="Limpieza (no disponible en esta fase)" Padding="10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Duplicados" />
                                    <ComboBox x:Name="DuplicateColumnComboBox" Grid.Row="0" Grid.Column="1" Margin="8,4" DisplayMemberPath="DisplayName" IsEnabled="False" AutomationProperties.Name="Columna para duplicados" />
                                    <Button Grid.Row="0" Grid.Column="2" Margin="8,4" Content="Quitar duplicados" IsEnabled="False" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Valores vacíos" />
                                    <ComboBox x:Name="EmptyColumnComboBox" Grid.Row="1" Grid.Column="1" Margin="8,4" DisplayMemberPath="DisplayName" IsEnabled="False" AutomationProperties.Name="Columna para vacíos" />
                                    <Button Grid.Row="1" Grid.Column="2" Margin="8,4" Content="Quitar valores vacíos" IsEnabled="False" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#FF777777" Text="La limpieza todavía no está disponible." />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Resumen y estado del ciclo" Padding="10" Margin="0,12,0,0">
                                <TextBlock Text="Sin ciclo iniciado. No se han leído ni modificado archivos." TextWrapping="Wrap" />
                            </GroupBox>
                            <Button Margin="0,12,0,0" HorizontalAlignment="Left" Width="220" Content="Generar archivo de salida" IsEnabled="False" />
                        </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#FFDDDDDD" />
                    <GroupBox Grid.Row="2" Header="Actividad — los eventos más recientes aparecerán primero" Padding="6">
                        <TextBox x:Name="ActivityTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="#FFF8F8F8" BorderThickness="0" />
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="SergioTab"><TextBlock Margin="12" Text="Disponible en una fase futura." /></TabItem>
            <TabItem x:Name="StockTab"><TextBlock Margin="12" Text="Disponible en una fase futura." /></TabItem>
            <TabItem x:Name="ConsultasTab"><TextBlock Margin="12" Text="Disponible en una fase futura." /></TabItem>
        </TabControl>

        <Border Grid.Row="4" Padding="8" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="#FFF9F9F9">
            <TextBlock Text="Selección de archivo y lectura de encabezados disponibles. Limpieza, exportación y persistencia todavía no." TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
