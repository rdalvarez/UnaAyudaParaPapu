<Window x:Class="PapaPersonas.V2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PapaPersonas.V2.App"
        Title="PapaPersonas V2"
        Height="760" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="150" MinHeight="120" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" CornerRadius="8" BorderBrush="#FFE6E6E6" BorderThickness="1" Background="#FFFDFDFD">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="PapaPersonas V2" />
                    <TextBlock Margin="0,4,0,0" Foreground="#FF666666" Text="Preparación y limpieza de archivos Excel" />
                </StackPanel>
                <StackPanel Grid.Column="1" x:Name="OperationProgressPanel" VerticalAlignment="Center" Margin="18,0,0,0" AutomationProperties.Name="Estado de la operación" AutomationProperties.LiveSetting="Polite">
                    <TextBlock x:Name="OperationStatusTextBlock" Text="Sin operaciones en curso." AutomationProperties.Name="Estado de la operación" />
                    <ProgressBar x:Name="OperationProgressBar" Margin="0,6,0,0" Height="8" IsIndeterminate="False" Value="0" AutomationProperties.Name="Progreso de la operación" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem x:Name="PrepararTab">
                <Grid Margin="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Preparar archivo de Hernán" />
                            <TextBlock Margin="0,4,0,14" Foreground="#FF666666" Text="Seleccione un archivo, arme el plan de limpieza y genere los archivos de salida. La exportación TXT, las fuentes CSV y la persistencia siguen fuera de alcance." TextWrapping="Wrap" />

                            <GroupBox Header="Archivos" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Archivo de entrada" />
                                    <TextBox x:Name="InputFileTextBox" Grid.Row="0" Grid.Column="1" Margin="8,4" IsReadOnly="True" />
                                    <Button x:Name="BrowseFileButton" Grid.Row="0" Grid.Column="2" Margin="8,4" Content="Buscar archivo" Click="BrowseFileButton_OnClick" />
                                    <TextBlock x:Name="RejectedFolderLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Carpeta de rechazados" Cursor="Hand" Foreground="#FF245A9B" TextDecorations="Underline" MouseLeftButtonUp="RejectedFolderLabel_OnClick" />
                                    <TextBox x:Name="RejectedFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4" IsReadOnly="True" />
                                    <Button x:Name="BrowseFolderButton" Grid.Row="1" Grid.Column="2" Margin="8,4" Content="Buscar carpeta" Click="BrowseFolderButton_OnClick" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Columnas detectadas" Padding="10" Margin="0,12,0,0">
                                <ListBox x:Name="DetectedColumnsListBox" Height="110" AutomationProperties.Name="Columnas detectadas">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Column.DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OutputColumnCheckBox_OnChanged" Unchecked="OutputColumnCheckBox_OnChanged" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

                            <GroupBox Header="Limpieza" Padding="10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Duplicados" />
                                    <ComboBox x:Name="DuplicateColumnComboBox" Grid.Row="0" Grid.Column="1" Margin="8,4" DisplayMemberPath="DisplayName" IsEnabled="False" SelectionChanged="CleaningColumnComboBox_OnSelectionChanged" AutomationProperties.Name="Columna para duplicados" />
                                    <Button x:Name="RemoveDuplicatesButton" Grid.Row="0" Grid.Column="2" Margin="8,4" Content="Quitar duplicados" IsEnabled="False" Click="RemoveDuplicatesButton_OnClick" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Valores vacíos" />
                                    <ComboBox x:Name="EmptyColumnComboBox" Grid.Row="1" Grid.Column="1" Margin="8,4" DisplayMemberPath="DisplayName" IsEnabled="False" SelectionChanged="CleaningColumnComboBox_OnSelectionChanged" AutomationProperties.Name="Columna para vacíos" />
                                    <Button x:Name="RemoveEmptyValuesButton" Grid.Row="1" Grid.Column="2" Margin="8,4" Content="Quitar valores vacíos" IsEnabled="False" Click="RemoveEmptyValuesButton_OnClick" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#FF777777" Text="Las acciones agregan pasos al plan; al generar, los pasos se ejecutan en el orden mostrado." TextWrapping="Wrap" />
                                    <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="15" FontWeight="SemiBold" Text="Plan de limpieza" />
                                        <Button x:Name="ClearCleaningPlanButton" Grid.Column="1" Content="Limpiar plan" IsEnabled="False" Click="ClearCleaningPlanButton_OnClick" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <ListBox x:Name="CleaningPlanListBox" Margin="0,8,0,0" MinHeight="42" DisplayMemberPath="VisibleDescription" AutomationProperties.Name="Pasos del plan de limpieza" />
                            <TextBlock x:Name="CleaningPlanSummaryTextBlock" Margin="0,4,0,0" Foreground="#FF666666" Text="Plan vacío." />

                            <GroupBox Header="Resumen y estado del ciclo" Padding="10" Margin="0,12,0,0">
                                <TextBlock x:Name="CycleSummaryTextBlock" Text="Sin ciclo iniciado. No se han leído ni modificado archivos." TextWrapping="Wrap" />
                            </GroupBox>
                            <Button x:Name="GenerateOutputButton" Margin="0,12,0,0" HorizontalAlignment="Left" Width="220" Content="Generar archivo de salida" IsEnabled="False" Click="GenerateOutputButton_OnClick" AutomationProperties.Name="Generar archivo de salida" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="SergioTab">
                <Grid Margin="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Ingresar archivo de Sergio" />
                             <TextBlock Margin="0,4,0,14" Foreground="#FF666666" Text="Seleccione un Excel, valide la clave y confirme una vista previa antes de actualizar la carga oficial." TextWrapping="Wrap" />
                            <GroupBox Header="Archivo" Padding="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Archivo de Sergio" />
                                    <TextBox x:Name="SergioFileTextBox" Grid.Column="1" Margin="8,4" IsReadOnly="True" />
                                    <Button x:Name="SergioBrowseFileButton" Grid.Column="2" Margin="8,4" Content="Buscar archivo" Click="SergioBrowseFileButton_OnClick" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Encabezados detectados y alias" Padding="10" Margin="0,12,0,0">
                                <ListBox x:Name="SergioHeadersListBox" Height="180" AutomationProperties.Name="Encabezados de Sergio">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2" /></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>
                            <GroupBox Header="Clave primaria" Padding="10" Margin="0,12,0,0">
                                <ComboBox x:Name="SergioPrimaryKeyComboBox" IsEnabled="False" AutomationProperties.Name="Clave primaria de Sergio" SelectionChanged="SergioPrimaryKeyComboBox_OnSelectionChanged" />
                            </GroupBox>
                             <Button x:Name="SergioValidateButton" Margin="0,12,0,0" Width="240" HorizontalAlignment="Left" Content="Validar y preparar carga" IsEnabled="False" Click="SergioValidateButton_OnClick" />
                             <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="SergioPreviewButton" Width="240" Content="Vista previa y cargar" IsEnabled="False" Click="SergioPreviewButton_OnClick" /><Button x:Name="SergioExportRejectedButton" Margin="8,0,0,0" Width="190" Content="Exportar rechazados" IsEnabled="False" Click="SergioExportRejectedButton_OnClick" AutomationProperties.Name="Exportar rechazados" /></StackPanel>
                            <TextBlock x:Name="SergioSummaryTextBlock" Margin="0,12,0,0" Foreground="#FF666666" Text="Estado: falta aceptar archivo, encabezados y clave primaria." TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="StockTab"><local:StockProcessControl x:Name="StockProcess" /></TabItem>
            <TabItem x:Name="ConsultasTab"><TextBlock Margin="12" Text="Disponible en una fase futura." /></TabItem>
        </TabControl>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#FFDDDDDD" />
        <GroupBox Grid.Row="4" Header="Actividad — los eventos más recientes aparecerán primero" Padding="6">
            <TextBox x:Name="ActivityTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="#FFF8F8F8" BorderThickness="0" />
        </GroupBox>

        <Border Grid.Row="6" Padding="8" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="#FFF9F9F9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DuckDbStatusHeadlineTextBlock" FontWeight="SemiBold" Text="Base local: inicializando DuckDB..." TextWrapping="Wrap" />
                    <TextBlock x:Name="DuckDbStatusDetailTextBlock" Margin="0,2,0,0" Foreground="#FF666666" Text="Se está validando la base local y su estado de Sergio." TextWrapping="Wrap" />
                    <TextBlock x:Name="DuckDbPathTextBlock" Margin="0,4,0,0" Foreground="#FF666666" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="" AutomationProperties.Name="Ruta DuckDB" />
                </StackPanel>
                <Button x:Name="DuckDbResetButton" Grid.Column="1" Margin="12,0,0,0" MinWidth="120" Height="30" VerticalAlignment="Top" Content="Reiniciar base" Click="DuckDbResetButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
