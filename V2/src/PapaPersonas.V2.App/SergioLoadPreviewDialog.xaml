<Window x:Class="PapaPersonas.V2.App.SergioLoadPreviewDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vista previa de carga de Sergio" Width="980" Height="650" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Vista previa y confirmación de carga"/><TextBlock x:Name="SummaryTextBlock" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="WarningTextBlock" Margin="0,8,0,12" FontWeight="Bold" Foreground="#FF9C2C" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Row="1" BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="8"><DataGrid x:Name="PreviewDataGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"/></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Width="110" Margin="0,0,8,0" Content="Cancelar" IsCancel="True" Click="CancelButton_OnClick"/><Button x:Name="PromoteButton" Width="130" Content="Cargar" IsDefault="True" Click="PromoteButton_OnClick"/></StackPanel>
    </Grid>
</Window>
