<Window x:Class="PapaPersonas.V2.App.SergioRejectionDecisionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Filas rechazadas" Width="520" SizeToContent="Height" MinWidth="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="La carga contiene filas rechazadas" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="MessageTextBlock" Margin="0,12,0,18" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="110" Margin="0,0,8,0" Content="Cancelar" IsCancel="True" Click="CancelButton_OnClick"/><Button Width="110" Content="Continuar" IsDefault="True" Click="ContinueButton_OnClick"/></StackPanel>
    </Grid>
</Window>
