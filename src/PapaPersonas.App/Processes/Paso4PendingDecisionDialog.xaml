<Window x:Class="PapaPersonas.App.Processes.Paso4PendingDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extracción pendiente" Height="250" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reintentar la extracción" Width="190" Margin="0,0,8,0" Click="Retry_Click" />
            <Button Content="Cancelar y liberar CUIL" Width="190" Click="CancelPending_Click" />
        </StackPanel>
    </Grid>
</Window>
