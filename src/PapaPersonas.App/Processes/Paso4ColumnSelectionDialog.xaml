<Window x:Class="PapaPersonas.App.Processes.Paso4ColumnSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar columnas" Height="560" Width="460"
        MinHeight="480" MinWidth="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="Elegí las columnas para exportaciones detalladas. CUIL, CODIGOOS y OBRASOCIAL son obligatorias." />

        <Border Grid.Row="2" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ColumnsStackPanel" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button Content="Cancelar" Width="110" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Guardar" Width="110" Click="Save_Click" />
        </DockPanel>
    </Grid>
</Window>
